#!/bin/bash
# Merge ~/.config/claude + ~/.config-local/claude into ~/.claude with drift prompts.
# Does not launch Claude — use for manual sync or from the claude wrapper.
set -euo pipefail

GLOBAL="$HOME/.config/claude"
LOCAL="$HOME/.config-local/claude"
DEST="$HOME/.claude"

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

# shellcheck source=lib/merge-config.sh
source "$(dirname "$0")/lib/merge-config.sh"

# Markdown files
merge_md "$GLOBAL/CLAUDE.md" "$LOCAL/CLAUDE.md" "$DEST/CLAUDE.md" "CLAUDE.md"

# JSON files
# "model" is left unmanaged — it changes too often to be worth syncing across machines.
merge_json "$GLOBAL/settings.json"    "$LOCAL/settings.json"    "$DEST/settings.json"    "settings.json" "model"
merge_json "$GLOBAL/keybindings.json" "$LOCAL/keybindings.json" "$DEST/keybindings.json" "keybindings.json"

# Directories (memory/ excluded — auto-generated by Claude, machine-local)
for dir in commands agents skills scripts; do
  if [[ -d "$GLOBAL/$dir" || -d "$LOCAL/$dir" ]]; then
    if [[ "$dir" == "skills" ]]; then
      # skills/synced/ is written at runtime by Claude Code's plugin system
      # (cached marketplace-provided skills) — not sourced from GLOBAL/LOCAL.
      # skills/.trash/ is also created by Claude Code at runtime.
      merge_dir "$GLOBAL/$dir" "$LOCAL/$dir" "$DEST/$dir" "$dir" "synced" ".trash"
    else
      merge_dir "$GLOBAL/$dir" "$LOCAL/$dir" "$DEST/$dir" "$dir"
    fi
  fi
done
